// Basic
LITERAL_TOKEN(Identifier, "identifier")
LITERAL_TOKEN(StrLiteral, "string literal")
LITERAL_TOKEN(CharLiteral, "char literal")
LITERAL_TOKEN(IntegerLiteral, "integer literal")
LITERAL_TOKEN(FloatLiteral, "float literal")

// Brackets
PUNCTUATION_TOKEN(LeftParen, "(")
PUNCTUATION_TOKEN(RightParen, ")")
PUNCTUATION_TOKEN(LeftBrace, "{")
PUNCTUATION_TOKEN(RightBrace, "}")
PUNCTUATION_TOKEN(LeftSquare, "[")
PUNCTUATION_TOKEN(RightSquare, "]")

// Punctuation
PUNCTUATION_TOKEN(Semicolon, ";")
PUNCTUATION_TOKEN(Colon, ":")
PUNCTUATION_TOKEN(Comma, ",")

// Misc

// Keywords
SPECIAL_TOKEN(_keywordStart, "<keyword-start>")  // meta for keyword info (nothing lexes to this)

KEYWORD_TOKEN(Let, "let")
KEYWORD_TOKEN(Mut, "mut")
KEYWORD_TOKEN(Ptr, "ptr")
KEYWORD_TOKEN(Uninitialized, "uninitialized")

KEYWORD_TOKEN(Private, "private")
KEYWORD_TOKEN(Public, "public")

KEYWORD_TOKEN(Int8, "int8")
KEYWORD_TOKEN(Int16, "int16")
KEYWORD_TOKEN(Int32, "int32")
KEYWORD_TOKEN(Int64, "int64")
KEYWORD_TOKEN(Int128, "int128")

KEYWORD_TOKEN(UInt8, "uint8")
KEYWORD_TOKEN(UInt16, "uint16")
KEYWORD_TOKEN(UInt32, "uint32")
KEYWORD_TOKEN(UInt64, "uint64")
KEYWORD_TOKEN(UInt128, "uint128")

KEYWORD_TOKEN(Float32, "float32")
KEYWORD_TOKEN(Float64, "float64")

KEYWORD_TOKEN(Char, "char")
KEYWORD_TOKEN(Bool, "bool")
KEYWORD_TOKEN(True, "true")
KEYWORD_TOKEN(False, "false")
KEYWORD_TOKEN(String, "string")

KEYWORD_TOKEN(If, "if")
KEYWORD_TOKEN(Elif, "elif")
KEYWORD_TOKEN(Else, "else")

KEYWORD_TOKEN(Switch, "switch")
KEYWORD_TOKEN(Case, "case")
KEYWORD_TOKEN(Default, "default")

KEYWORD_TOKEN(For, "for")
KEYWORD_TOKEN(Foreach, "foreach")
KEYWORD_TOKEN(While, "while")
KEYWORD_TOKEN(Do, "do")
KEYWORD_TOKEN(Break, "break")
KEYWORD_TOKEN(Continue, "continue")
KEYWORD_TOKEN(In, "in")

KEYWORD_TOKEN(Func, "func")
KEYWORD_TOKEN(Lambda, "lambda")
KEYWORD_TOKEN(Return, "return")

KEYWORD_TOKEN(Import, "import")
KEYWORD_TOKEN(Module, "module")
KEYWORD_TOKEN(Namespace, "namespace")
KEYWORD_TOKEN(As, "as")

KEYWORD_TOKEN(Aggregate, "aggregate")
KEYWORD_TOKEN(Enum, "enum")

KEYWORD_TOKEN(Alias, "alias")
KEYWORD_TOKEN(Alignof, "alignof")
KEYWORD_TOKEN(Sizeof, "sizeof")
KEYWORD_TOKEN(Typeof, "typeof")

SPECIAL_TOKEN(_keywordEnd, "<keyword-end>")  // meta for keyword info (nothing lexes to this)

// Operators
SPECIAL_TOKEN(_operatorStart, "<operator-start>")  // meta for operator info (nothing lexes to this)

OPERATOR_TOKEN(Plus, "+")
OPERATOR_TOKEN(Minus, "-")
OPERATOR_TOKEN(Mul, "*")
OPERATOR_TOKEN(Div, "/")
OPERATOR_TOKEN(FloorDiv, "//")
OPERATOR_TOKEN(Mod, "%")

OPERATOR_TOKEN(Inc, "++")
OPERATOR_TOKEN(Dec, "--")

OPERATOR_TOKEN(UnaryPlus, "+")
OPERATOR_TOKEN(UnaryMinus, "-")

OPERATOR_TOKEN(PlusAssign, "+=")
OPERATOR_TOKEN(MinusAssign, "-=")
OPERATOR_TOKEN(MulAssign, "*=")
OPERATOR_TOKEN(DivAssign, "/=")
OPERATOR_TOKEN(FloorDivAssign, "//=")
OPERATOR_TOKEN(ModAssign, "%=")

OPERATOR_TOKEN(GreaterThan, ">")
OPERATOR_TOKEN(GreaterThanOrEqual, ">=")
OPERATOR_TOKEN(LessThan, "<")
OPERATOR_TOKEN(LessThanOrEqual, "<=")
OPERATOR_TOKEN(Equal, "==")
OPERATOR_TOKEN(NotEqual, "!=")

OPERATOR_TOKEN(And, "&&")
OPERATOR_TOKEN(Or, "||")
OPERATOR_TOKEN(Not, "!")
OPERATOR_TOKEN(Ternary, "?")

OPERATOR_TOKEN(BitAnd, "&")
OPERATOR_TOKEN(BitOr, "|")
OPERATOR_TOKEN(BitNot, "~")
OPERATOR_TOKEN(BitXor, "^")
OPERATOR_TOKEN(BitLShift, "<<")
OPERATOR_TOKEN(BitRShift, ">>")

OPERATOR_TOKEN(BitAndAssign, "&=")
OPERATOR_TOKEN(BitOrAssign, "|=")
OPERATOR_TOKEN(BitXorAssign, "^=")
OPERATOR_TOKEN(BitLShiftAssign, "<<=")
OPERATOR_TOKEN(BitRShiftAssign, ">>=")

OPERATOR_TOKEN(AddressOf, "&")
OPERATOR_TOKEN(Dereference, "*")

OPERATOR_TOKEN(MemberAccess, ".")
OPERATOR_TOKEN(ScopeResolution, "::")

OPERATOR_TOKEN(Assignment, "=")
OPERATOR_TOKEN(Arrow, "->")
OPERATOR_TOKEN(Ellipsis, "...")
OPERATOR_TOKEN(At, "@")

SPECIAL_TOKEN(_operatorEnd, "<operator-end>") // meta for operator info (nothing lexes to this)

SPECIAL_TOKEN(Unknown, "<unknown>")
SPECIAL_TOKEN(EndOfFile, "<eof>")

SPECIAL_TOKEN(_tokenCount, "<count>")  // sentinel value for arrays